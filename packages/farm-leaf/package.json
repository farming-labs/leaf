{
  "name": "farm-leaf",
  "version": "0.0.0",
  "private": true,
  "description": "The Farm renderer for leaf: a descriptor, three modules, and hooks over Farm's client stores.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./bindings": {
      "types": "./dist/bindings.d.ts",
      "default": "./dist/bindings.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@farm.js/core": "0.1.81",
    "@farm.js/renderer-tests": "0.1.0-beta.1",
    "jsdom": "^25.0.0",
    "leaf": "workspace:*",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@farm.js/core": ">=0.1.81 <0.3.0",
    "leaf": "*",
    "vite": "*"
  }
}
